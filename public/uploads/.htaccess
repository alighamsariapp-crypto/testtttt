# ==============================================================================
# APEXSTORE HARDENED UPLOADS SECURITY CONFIGURATION
# ==============================================================================
# Strictly prevent execution of any script, server-side code, or active content.

Options -ExecCGI -Indexes
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phps .cgi .pl .asp .aspx .shtml
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phps .cgi .pl .asp .aspx .shtml

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# Force default handler to prevent script execution by Apache/PHP-FPM
SetHandler default-handler

# Strictly deny any scriptable, executable, or active formats
<FilesMatch "\.(php[0-9]?|phtml|phps|cgi|pl|sh|bash|py|rb|js|html|htm|shtml|svg|xml|exe|bin|bat|phar)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Enforce security headers on served media assets
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set Content-Security-Policy "default-src 'none'; sandbox"
    Header set X-Frame-Options "DENY"
    Header set Content-Disposition "inline"
</IfModule>
