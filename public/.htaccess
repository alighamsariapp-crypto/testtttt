<IfModule mod_dir.c>
    DirectoryIndex index.html index.php
</IfModule>

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Preserve Bearer tokens for Laravel/Sanctum on Apache + PHP-FPM.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Do not rewrite physical files or folders. This guarantees that Vite bundles
    # in /assets and public files in /storage are served by Apache directly.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # API and Sanctum must always be handled by Laravel, including unknown API URLs.
    RewriteRule ^(?:api(?:/|$)|sanctum(?:/|$)) index.php [L]

    # A missing static file must be a real 404, never the SPA HTML shell.
    RewriteCond %{REQUEST_URI} ^/(?:assets|storage|uploads)(?:/|$) [NC,OR]
    RewriteCond %{REQUEST_URI} \.(?:js|mjs|css|map|json|png|jpe?g|gif|svg|ico|webp|avif|woff2?|ttf|eot)$ [NC]
    RewriteRule ^ - [R=404,L]

    # Explicit client-side routes. These are the only paths that return the SPA shell.
    RewriteRule ^(?:$|store(?:/.*)?|product(?:/.*)?|services(?:/.*)?|service(?:/.*)?|cart|checkout|payment-status|auth|magazine(?:/.*)?|about|contact|profile(?:/.*)?|admin(?:/.*)?|typography-test)$ index.html [L]

    # Block direct access to storage internals, logs, database files, and git metadata
    RewriteRule ^(?:storage/framework|storage/logs|\.env|database|node_modules|vendor) - [F,L]

    # Let Laravel handle any other request (including a genuine 404).
    RewriteRule ^ index.php [L]
</IfModule>

# Apply the same baseline to static SPA routes that Apache serves directly and therefore do not pass through Laravel middleware.
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https: blob:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self';"

    # Vite assets are content-hashed, but the SPA HTML entry must always be
    # revalidated. FilesMatch receives the actual file after the internal SPA
    # rewrite, so this one portable rule also covers direct SPA routes.
    <FilesMatch "^index\.html$">
        Header always set Cache-Control "no-cache, max-age=0, must-revalidate"
        Header always set Pragma "no-cache"
        Header always set Expires "0"
    </FilesMatch>
</IfModule>

# Protect deployment, database, environment, and configuration files.
<FilesMatch "(^\.|\.env.*|composer\.(json|lock)|package(-lock)?\.json|pnpm-lock\.yaml|artisan|.*\.sqlite.*|.*\.key|.*\.sql|web\.config)$">
    Order allow,deny
    Deny from all
</FilesMatch>
