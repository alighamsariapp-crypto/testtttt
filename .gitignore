node_modules/
vendor/
build/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example

# Local investigation and SQLite runtime data
/.local-investigation-notes.md
/database/*.sqlite
/storage/*.key
/storage/logs/*
!/storage/logs/.gitignore
/storage/framework/cache/*
!/storage/framework/cache/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
.phpunit.result.cache
/bootstrap/cache/*.php
!/bootstrap/cache/.gitignore

# Vite writes the deployable SPA entry and content-hashed asset graph here.
# They are generated by `pnpm build` and must not be source-controlled.
/public/index.html
/public/assets/

# Local output from shared-hosting artifact builds
.deployment-artifact/

# Runtime user uploads (persistent storage; must never be committed to source control)
/public/uploads/*
!/public/uploads/.htaccess
!/public/uploads/.gitkeep
!/public/uploads/*/.gitkeep

# Temporary upload staging directories
/.staging_uploads/
/storage/app/tmp_uploads/

# Deterministic test fixtures must remain tracked in source control
!/tests/fixtures/media/
!/tests/fixtures/media/**
